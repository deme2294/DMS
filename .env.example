# ==============================================================================
# DMS HELP DESK MANAGEMENT SYSTEM — PRODUCTION ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and replace placeholders with secure production values.
# DO NOT COMMIT YOUR ACTUAL .env FILE TO GIT.
# ==============================================================================

# ── Service Image Tags & Versioning ──────────────────────────────────────────
# Set to your Docker Hub registry image tag when deploying pre-built images:
# Example: FRONTEND_IMAGE=yourdockerhubusername/dms-frontend:1.0.0
FRONTEND_IMAGE=dms-frontend:1.0.0
BACKEND_IMAGE=dms-backend:1.0.0
DATABASE_IMAGE=dms-database:1.0.0

# ── Service Port Mappings ────────────────────────────────────────────────────
# Port where public users reach the system (served via Nginx):
FRONTEND_PORT=80

# Internal/Admin loopback bindings (bind to 127.0.0.1 so they are never exposed to public WAN):
BACKEND_PORT=5000
BACKEND_BIND_IP=127.0.0.1

DB_PORT=3307
DB_BIND_IP=127.0.0.1

PMA_PORT=8081
PMA_BIND_IP=127.0.0.1

# ── Database Configuration (MariaDB 10.11 LTS) ───────────────────────────────
DB_HOST=db
DB_NAME=helpdesk_db
# Dedicated application user (least-privilege, non-root)
DB_USER=dms_app
DB_PASSWORD=replace_with_strong_database_password
# Database root password (used strictly for database maintenance and schema init)
DB_ROOT_PASSWORD=replace_with_strong_root_password

# ── Application Environment & CORS ───────────────────────────────────────────
NODE_ENV=production
# The public domain name where users access your frontend (NO trailing slash):
FRONTEND_URL=https://helpdesk.yourdomain.com
VITE_API_URL=/api

# ── Authentication & Security Secrets ────────────────────────────────────────
# Generate secure 32+ character random strings with: openssl rand -hex 32
JWT_SECRET=replace_with_32_plus_char_random_jwt_secret
SESSION_SECRET=replace_with_32_plus_char_random_session_secret
JWT_ACCESS_SECRET=replace_with_32_plus_char_random_access_secret
JWT_REFRESH_SECRET=replace_with_32_plus_char_random_refresh_secret
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d

# ── Rate Limiting & Account Security ─────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=30
RECAPTCHA_SECRET_KEY=

# ── Email (SMTP) Configuration (Nodemailer) ───────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password

# ── phpMyAdmin Settings (Optional tool profile) ───────────────────────────────
PMA_UPLOAD_LIMIT=128M
PMA_MEMORY_LIMIT=256M
