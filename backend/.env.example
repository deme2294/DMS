# ==============================================================================
# DMS Help Desk Backend - Environment Template
# Copy this file to .env and adjust values for local or Docker development.
# ==============================================================================

PORT=5000
NODE_ENV=development

# ── Database Target Configuration ──────────────────────────────────────────
# Both databases can run simultaneously on your machine:
#   • XAMPP MySQL:  127.0.0.1:3306 (user: root, password: empty)
#   • Docker MySQL: 127.0.0.1:3307 (user: root, password: root)
#
# Choose which database to connect to:
#   DB_TARGET=xampp    -> Connects to XAMPP MySQL on port 3306 (see .env.xampp)
#   DB_TARGET=docker   -> Connects to Docker MySQL on port 3307 (see .env.docker)
DB_TARGET=xampp

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=helpdesk_db

# ── Authentication & Security Secrets ────────────────────────────────────────
JWT_SECRET=your_jwt_secret_min_32_chars_random_string_here
SESSION_SECRET=your_session_secret_min_32_chars_random_string
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_random_string
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_random_string
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d

# ── Application Configuration ────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=30
RECAPTCHA_SECRET_KEY=

# ── Email (SMTP) Configuration ───────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
